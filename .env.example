# .env 로 복사해서 채우세요. SUPABASE_URL이 비어 있으면 로컬 SQLite(data/futsal.db)를 씁니다.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=<service_role 또는 sb_secret_ 키 — 서버 전용, 절대 브라우저에 노출 금지>
ADMIN_PASSWORD=
# 새 등록/수정 요청을 알릴 Slack Incoming Webhook 주소. 비우면 알림이 꺼집니다.
SLACK_WEBHOOK_URL=
# Google Analytics 4 측정 ID (G-로 시작). 비우면 GA가 꺼집니다.
GA_MEASUREMENT_ID=
# 프록시(Vercel, Fly 등) 뒤에 배포할 때 1
TRUST_PROXY=
